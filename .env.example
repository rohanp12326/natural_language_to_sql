# Database credentials
DB_HOST="database_host"
DB_PORT="5432"
DB_DATABASE="database_name"
DB_USER="database_username"
DB_PASSWORD="database_password"

# Z.ai (Zhipu AI) GLM Configuration - z.ai or open.bigmodel.cn
ZAI_API_KEY="your_z_ai_api_key"
# International endpoint: https://api.z.ai/api/paas/v4 | Domestic endpoint: https://open.bigmodel.cn/api/paas/v4
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Models
ZAI_MODEL_FAST="glm-5.3-flash"      # Fast, intelligent model for routing, chat, and SQL generation
ZAI_MODEL_POWERFUL="glm-4.5-air"    # High-reasoning model for error fixing and analysis
ZAI_MODEL_EMBEDDING="local"         # Local ONNX all-MiniLM embeddings (0 external cost)

# LangSmith (Track tokens/costs & debugging) - smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="langsmith_token"
LANGSMITH_PROJECT="langsmith_project_name"
