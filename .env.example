# Database credentials
DB_HOST="database_host"
DB_PORT="5432"
DB_DATABASE="database_name"
DB_USER="database_username"
DB_PASSWORD="database_password"

# Z.ai (Zhipu AI) GLM Configuration - z.ai or open.bigmodel.cn
ZAI_API_KEY="your_z_ai_api_key"
# International endpoint: https://api.z.ai/api/paas/v4 | Domestic endpoint: https://open.bigmodel.cn/api/paas/v4
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Models
ZAI_MODEL_FAST="glm-4-flash"        # Free, high-speed model for routing, chat, and SQL generation
ZAI_MODEL_POWERFUL="glm-4-air"      # Ultra-low cost, high-intelligence model for error fixing and analysis
ZAI_MODEL_EMBEDDING="embedding-3"   # Vector embeddings for RAG knowledge base

# LangSmith (Track tokens/costs & debugging) - smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="langsmith_token"
LANGSMITH_PROJECT="langsmith_project_name"
